# PostgreSQL Database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studymatedb?schema=public"

# JWT Secret for student authentication sessions
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# Backend Server Port
PORT=5001

# Client URL (for CORS allowance)
FRONTEND_URL="http://localhost:5173"

# Server-side LLM API Configuration (Never exposed to frontend code)
# Supports Google Gemini API key or OpenAI-compatible API key
LLM_API_KEY=""
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-flash"
