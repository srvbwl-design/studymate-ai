# Database configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studymatedb?schema=public"

# Authentication
JWT_SECRET="your-super-secret-jwt-key-study-mate-2025"
JWT_EXPIRES_IN="7d"

# Server Port
PORT=5001

# Client Application URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# LLM API Configuration (Strictly server-side - NEVER exposed to frontend)
# Supports Google Gemini API key or OpenAI-compatible key
LLM_API_KEY=
LLM_PROVIDER="gemini"
LLM_MODEL="gemini-1.5-flash"
